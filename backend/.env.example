# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5080,http://localhost:5081,http://localhost:3001
# In production set to your deployed Flutter web URL e.g.:
# ALLOWED_ORIGINS=https://campuscore-production-3f94.up.railway.app,http://localhost:5080,http://localhost:5081

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=campuscore

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# AI (OpenAI-compatible — works with OpenAI, Together AI, Groq, Mistral, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1        # default OpenAI
# OPENAI_BASE_URL=https://api.together.xyz/v1       # Together AI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # Groq

# Stellar Integration
STELLAR_NETWORK=testnet                                    # testnet or mainnet
STELLAR_BACKEND_SECRET=your_stellar_secret_key            # Backend keypair for minting
STELLAR_REPUTATION_CONTRACT_ID=your_reputation_contract   # Deployed on Soroban
STELLAR_BADGE_CONTRACT_ID=your_badge_contract             # Deployed on Soroban
STELLAR_CONTRIBUTION_CONTRACT_ID=your_contribution_contract # Deployed on Soroban

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
