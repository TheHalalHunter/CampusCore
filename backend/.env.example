# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
# Defaults (if unset): https://campuscore-5658f.web.app, https://campuscore-admin.web.app, http://localhost:3000, http://localhost:4200
CORS_ORIGINS=https://campuscore-5658f.web.app,https://campuscore-admin.web.app,http://localhost:3000,http://localhost:4200

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d
EMAIL_VERIFICATION_SECRET=your_email_verification_secret_here

# SMTP (email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=CampusCore <noreply@campuscore.ng>

# Brevo (HTTP email API — no SMTP ports, works on Render, 300 emails/day free)
BREVO_API_KEY=xkeysib-your_api_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=campuscore

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# AI (OpenAI-compatible — works with OpenAI, Together AI, Groq, Mistral, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1        # default OpenAI
# OPENAI_BASE_URL=https://api.together.xyz/v1       # Together AI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # Groq

# Stellar Integration
STELLAR_NETWORK=testnet                                    # testnet or mainnet
STELLAR_BACKEND_SECRET=your_stellar_secret_key            # Backend keypair for minting
STELLAR_REPUTATION_CONTRACT_ID=your_reputation_contract   # Deployed on Soroban
STELLAR_BADGE_CONTRACT_ID=your_badge_contract             # Deployed on Soroban
STELLAR_CONTRIBUTION_CONTRACT_ID=your_contribution_contract # Deployed on Soroban

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Telegram Notifications (security alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
